# Opaq web app. NEXT_PUBLIC_* values are inlined into the browser bundle: never put a secret here.
#
# Cluster the programs are deployed on: devnet (default) or localnet.
NEXT_PUBLIC_OPAQ_CLUSTER=devnet
# RPC endpoint. The public devnet RPC rate-limits; use your own for anything beyond a demo.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Optional Opaq server (indexer + relayer). Without it the app scans over RPC.
# NEXT_PUBLIC_OPAQ_SERVER_URL=http://localhost:8787
# Optional overrides of the cluster's program IDs.
# NEXT_PUBLIC_OPAQ_REGISTRY_PROGRAM_ID=
# NEXT_PUBLIC_OPAQ_VAULT_PROGRAM_ID=
#
# Local work without devnet SOL or USDC: run `pnpm --filter @opaq/integration-tests dev-net`
# (after `anchor build`), then:
# NEXT_PUBLIC_OPAQ_CLUSTER=localnet
# NEXT_PUBLIC_RPC_URL=http://localhost:8899
