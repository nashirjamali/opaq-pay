# Copy to .env next to compose.prod.yaml's working directory. Never commit the real file.
POSTGRES_PASSWORD=change-me
RELAYER_KEYPAIR_FILE=/root/apps/opaq/secrets/relayer.json
# RPC_URL=https://api.devnet.solana.com
# NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Chains the payer page offers. Add arc to accept payments from Arc Testnet (Circle CCTP); rebuild web and server.
# NEXT_PUBLIC_OPAQ_ENABLED_CHAINS=solana,arc
# API_DOMAIN=api.opaq.nashir.tech
# WEB_DOMAIN=opaq.nashir.tech
# Privy app id (public; inlined into the web bundle at build time). Without it Google sign-in shows as coming soon.
# NEXT_PUBLIC_PRIVY_APP_ID=
