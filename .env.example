# Opaq SDK deployment config (read with configFromEnv from @opaq/sdk).
# Cluster: devnet (default) or localnet (program IDs from the local anchor build).
OPAQ_CLUSTER=devnet
# Optional overrides of the cluster's program IDs.
# OPAQ_REGISTRY_PROGRAM_ID=DaqD6ZznS3TP1NbC2tPrUiBjMNwPbJR3GseHZsBXABNk
# OPAQ_VAULT_PROGRAM_ID=9hoWkfxQ7igd7LJvmeVt1DjPrctY4wrVR7qgcqNZJn1Q
# Source chains, comma separated. MVP: solana only. base/arbitrum are rejected until CCTP lands.
OPAQ_ENABLED_CHAINS=solana

# --- apps/server (indexer + relayer) ---
DATABASE_URL=postgres://localhost:5432/opaq
RPC_URL=https://api.devnet.solana.com
# PORT=8787
# INDEXER_ENABLED=true
# INDEXER_COMMITMENT=finalized
# INDEXER_POLL_MS=2000
# Relayer key: SOL only, funded from an Opaq treasury unrelated to any user.
# RELAYER_KEYPAIR_PATH=/secure/path/relayer.json
# RELAYER_ENABLED=true
# RELAYER_MAX_LAMPORTS_PER_TX=20000000
# RELAYER_DAILY_LAMPORT_BUDGET=2000000000
# RELAYER_REQUESTS_PER_MINUTE=60
# TRUST_PROXY=false
